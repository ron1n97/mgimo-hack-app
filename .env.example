# Copy to .env — never commit real secrets

POSTGRES_USER=dekanat
POSTGRES_PASSWORD=dekanat
POSTGRES_DB=dekanat
DATABASE_URL=postgresql://dekanat:dekanat@localhost:5432/dekanat?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRES_IN=7d

API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# z.ai Coding Plan (OpenAI-compatible) — same stack as Hermes
# Local: copy key from ~/.kimi/.zai-api-key
ZCODE_API_KEY=
ZCODE_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZCODE_MODEL=glm-5.3

# Dedicated BotFather token for Деканат+ (do NOT reuse Hermes gateway token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# MCP stdio server: JWT after phone/email login
DEKANAT_ACCESS_TOKEN=

RUZ_BASE_URL=https://ruz.mgimo.ru
RUZ_SYNC_CRON="0 */6 * * *"

DISCLAIMER_MODE=contest

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
# Public key must also be available to the web client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@dekanat.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
