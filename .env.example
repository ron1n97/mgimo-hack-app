# Copy to .env — never commit real secrets

POSTGRES_USER=dekanat
POSTGRES_PASSWORD=dekanat
POSTGRES_DB=dekanat
DATABASE_URL=postgresql://dekanat:dekanat@localhost:5432/dekanat?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRES_IN=7d

API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Z Code / OpenRouter-compatible
ZCODE_API_KEY=
ZCODE_BASE_URL=https://openrouter.ai/api/v1
ZCODE_MODEL=openai/gpt-4o-mini

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

RUZ_BASE_URL=https://ruz.mgimo.ru
RUZ_SYNC_CRON="0 */6 * * *"

DISCLAIMER_MODE=contest
