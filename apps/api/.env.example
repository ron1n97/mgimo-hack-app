DATABASE_URL=postgresql://dekanat:dekanat@localhost:5432/dekanat?schema=public
JWT_SECRET=change-me-in-production-use-long-random
JWT_EXPIRES_IN=7d
API_PORT=3001

# Z Code / OpenRouter-compatible (optional — stubs used when empty)
ZCODE_API_KEY=
ZCODE_BASE_URL=https://openrouter.ai/api/v1
ZCODE_MODEL=openai/gpt-4o-mini

DISCLAIMER_MODE=contest

# Contest demo: persona buttons → POST /auth/demo-login (no passwords in clients).
# Production: set true on the demo VPS; omit/false elsewhere.
DEMO_QUICK_LOGIN=true
