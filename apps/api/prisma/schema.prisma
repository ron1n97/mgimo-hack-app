generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
  TEACHER
}

enum TicketStatus {
  SUBMITTED
  IN_PROGRESS
  DONE
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  /// E.164 phone for Telegram contact auth (demo: +7900…)
  phoneE164    String?  @unique
  /// Linked Telegram user id (stringified bigint)
  telegramId   String?  @unique
  createdAt    DateTime @default(now())

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  teacherProfile TeacherProfile?
  grades         Grade[]         @relation("StudentGrades")
  tickets        RequestTicket[] @relation("StudentTickets")
  requestEvents  RequestEvent[]  @relation("RequestActor")
  notifications  Notification[]
  teacherAssignmentsMade LessonTeacherAssignment[] @relation("AssignmentAssigner")
  lessonTasksCreated     LessonTask[]              @relation("TaskAuthor")
}

model StudentProfile {
  userId     String  @id
  fullName   String
  faculty    String
  program    String
  course     Int
  groupLabel String
  groupRuzId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  userId     String @id
  fullName   String
  department String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Teacher cabinet profile (Role.TEACHER). RUZ lecturer string is not SoT for auth.
model TeacherProfile {
  userId          String  @id
  fullName        String
  department      String?
  /// Optional free-text constraints stub (solver out of scope for this slice)
  constraintNotes String?

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments LessonTeacherAssignment[]
}

/// Dean/staff overlay: which teacher owns which RUZ slot or group+discipline.
model LessonTeacherAssignment {
  id               String   @id @default(cuid())
  teacherUserId    String
  /// Concrete RUZ-mirrored lesson when assigning a specific slot
  scheduleLessonId String?
  /// Soft key when assigning by group + discipline (series)
  groupRuzId       String?
  groupLabel       String?
  discipline       String?
  assignedByUserId String
  createdAt        DateTime @default(now())

  teacher        TeacherProfile  @relation(fields: [teacherUserId], references: [userId], onDelete: Cascade)
  scheduleLesson ScheduleLesson? @relation(fields: [scheduleLessonId], references: [id], onDelete: Cascade)
  assignedBy     User            @relation("AssignmentAssigner", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  tasks          LessonTask[]

  @@index([teacherUserId])
  @@index([groupRuzId, discipline])
  @@index([scheduleLessonId])
}

/// Homework / task attached by a teacher to an assigned slot; visible to students of groupRuzId.
model LessonTask {
  id               String    @id @default(cuid())
  assignmentId     String
  title            String
  body             String
  dueAt            DateTime?
  /// Denormalized for student list queries / IDOR scope
  groupRuzId       String
  scheduleLessonId String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignment LessonTeacherAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdBy  User                    @relation("TaskAuthor", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([groupRuzId, dueAt])
  @@index([createdByUserId])
  @@index([assignmentId])
}

model ScheduleLesson {
  id            String   @id @default(cuid())
  ruzExternalId String
  groupRuzId    String
  groupLabel    String
  date          DateTime @db.Date
  begin         String
  end           String
  discipline    String
  lecturer      String?
  auditorium    String?
  building      String?
  kindOfWork    String?
  isCancelled   Boolean  @default(false)
  isMoved       Boolean  @default(false)
  rawJson       Json?

  teacherAssignments LessonTeacherAssignment[]

  @@unique([ruzExternalId, groupRuzId, date, begin])
  @@index([groupRuzId, date])
  @@index([date])
}

model Grade {
  id            String  @id @default(cuid())
  studentUserId String
  discipline    String
  grade         String
  gradeType     String
  semester      String
  isDebt        Boolean @default(false)

  student User @relation("StudentGrades", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

model RequestTicket {
  id            String       @id @default(cuid())
  studentUserId String
  type          String
  title         String
  body          String
  status        TicketStatus @default(SUBMITTED)
  aiDraft       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student User           @relation("StudentTickets", fields: [studentUserId], references: [id], onDelete: Cascade)
  events  RequestEvent[]

  @@index([studentUserId])
  @@index([status])
}

model RequestEvent {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  note        String?
  actorUserId String
  createdAt   DateTime      @default(now())

  ticket RequestTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User          @relation("RequestActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
