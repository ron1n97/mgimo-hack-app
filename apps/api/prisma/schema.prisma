generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum TicketStatus {
  SUBMITTED
  IN_PROGRESS
  DONE
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  /// E.164 phone for Telegram contact auth (demo: +7900…)
  phoneE164    String?  @unique
  /// Linked Telegram user id (stringified bigint)
  telegramId   String?  @unique
  createdAt    DateTime @default(now())

  studentProfile StudentProfile?
  staffProfile   StaffProfile?
  grades         Grade[]         @relation("StudentGrades")
  tickets        RequestTicket[] @relation("StudentTickets")
  requestEvents  RequestEvent[]  @relation("RequestActor")
  notifications  Notification[]

  clubsCreated           Club[]                   @relation("ClubCreatedBy")
  clubsConfirmed         Club[]                   @relation("ClubConfirmedBy")
  clubMemberships        ClubMembership[]
  clubSubscriptions      ClubSubscription[]
  tagSubscriptions       StudentTagSubscription[]
  digestSourcesCreated   ClubSource[]             @relation("ClubSourceCreatedBy")
  eventsModerated        EventCandidate[]         @relation("EventModeratedBy")
}

model StudentProfile {
  userId     String  @id
  fullName   String
  faculty    String
  program    String
  course     Int
  groupLabel String
  groupRuzId String?
  /// Preferred RUZ subGroupOid values (language/stream parallels within academic group)
  preferredSubGroupOids String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StaffProfile {
  userId     String @id
  fullName   String
  department String
  /// Catalog group for schedule oversight / viewing (not student enrollment)
  scheduleGroupRuzId  String?
  scheduleGroupLabel  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ScheduleLessonSource {
  RUZ
  LOCAL
}

model ScheduleLesson {
  id            String               @id @default(cuid())
  ruzExternalId String
  groupRuzId    String
  groupLabel    String
  date          DateTime             @db.Date
  begin         String
  end           String
  discipline    String
  lecturer      String?
  auditorium    String?
  building      String?
  kindOfWork    String?
  subGroup      String?
  subGroupOid   String?
  stream        String?
  streamOid     String?
  /// RUZ = imported; LOCAL = self-planned / edited ownership (never overwritten by RUZ)
  source        ScheduleLessonSource @default(RUZ)
  isCancelled   Boolean              @default(false)
  isMoved       Boolean              @default(false)
  rawJson       Json?

  @@unique([ruzExternalId, groupRuzId, date, begin])
  @@index([groupRuzId, date])
  @@index([groupRuzId, subGroupOid])
  @@index([date])
}

model Grade {
  id            String  @id @default(cuid())
  studentUserId String
  discipline    String
  grade         String
  gradeType     String
  semester      String
  isDebt        Boolean @default(false)

  student User @relation("StudentGrades", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

model RequestTicket {
  id            String       @id @default(cuid())
  studentUserId String
  type          String
  title         String
  body          String
  status        TicketStatus @default(SUBMITTED)
  aiDraft       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student User           @relation("StudentTickets", fields: [studentUserId], references: [id], onDelete: Cascade)
  events  RequestEvent[]

  @@index([studentUserId])
  @@index([status])
}

model RequestEvent {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  note        String?
  actorUserId String
  createdAt   DateTime      @default(now())

  ticket RequestTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User          @relation("RequestActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ClubStatus {
  DRAFT
  CONFIRMED
}

enum ClubSourceKind {
  TELEGRAM
  VK
  WEBSITE
}

enum ClubMembershipRole {
  OWNER
  MEMBER
}

enum EventModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Student organization / club in the registry.
model Club {
  id                String     @id @default(cuid())
  name              String
  description       String?
  status            ClubStatus @default(DRAFT)
  digestEnabled     Boolean    @default(false)
  websiteUrl        String?
  structureNote     String?
  createdByUserId   String?
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  createdBy   User?             @relation("ClubCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmedBy User?             @relation("ClubConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  tags        ClubTag[]
  sources     ClubSource[]
  memberships ClubMembership[]
  subscribers ClubSubscription[]
  events      EventCandidate[]

  @@index([status])
  @@index([digestEnabled])
  @@index([name])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  clubs         ClubTag[]
  subscriptions StudentTagSubscription[]
}

model ClubTag {
  clubId String
  tagId  String

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clubId, tagId])
  @@index([tagId])
}

/// TG/VK/website source for digest ingest (may exist without a club).
model ClubSource {
  id              String         @id @default(cuid())
  clubId          String?
  kind            ClubSourceKind
  url             String
  title           String?
  enabled         Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())

  club      Club?             @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("ClubSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events    EventCandidate[]

  @@index([clubId])
  @@index([kind, enabled])
  @@unique([url])
}

model ClubMembership {
  id        String              @id @default(cuid())
  clubId    String
  userId    String
  role      ClubMembershipRole  @default(OWNER)
  createdAt DateTime            @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

model StudentTagSubscription {
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model ClubSubscription {
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([userId, clubId])
  @@index([clubId])
}

/// Candidate post/event from a digest source; staff moderation before afisha publish.
model EventCandidate {
  id               String                @id @default(cuid())
  clubId           String?
  sourceId         String?
  title            String
  body             String?
  url              String?
  startsAt         DateTime?
  moderationStatus EventModerationStatus @default(PENDING)
  moderatedAt      DateTime?
  moderatedByUserId String?
  publishedAt      DateTime?
  createdAt        DateTime              @default(now())

  club        Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  source      ClubSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  moderatedBy User?       @relation("EventModeratedBy", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@index([moderationStatus, createdAt])
  @@index([clubId])
  @@index([sourceId])
}
