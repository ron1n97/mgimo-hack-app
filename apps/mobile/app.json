{
  "expo": {
    "name": "Деканат+",
    "slug": "dekanat-plus",
    "scheme": "dekanat",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "plus.dekanat.mobile"
    },
    "android": {
      "package": "plus.dekanat.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#162256"
      }
    },
    "extra": {
      "apiUrl": "http://localhost:3001"
    }
  }
}
